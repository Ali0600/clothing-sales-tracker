{
  "expo": {
    "name": "Clothing Sales Tracker",
    "slug": "clothing-sales-tracker",
    "owner": "mhassan0600",
    "version": "1.0.0",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "scheme": "cst",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.cst.mobile",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.cst.mobile"
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-router"
    ],
    "extra": {
      "snapshotBaseUrl": "https://raw.githubusercontent.com/Ali0600/clothing-sales-tracker/main/data",
      "github": {
        "owner": "Ali0600",
        "repo": "clothing-sales-tracker",
        "workflowFile": "scrape.yml",
        "branch": "main"
      },
      "freshness": {
        "staleAfterMinutes": 30,
        "minTriggerIntervalMinutes": 5,
        "pollIntervalSeconds": 10,
        "pollTimeoutSeconds": 180
      },
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "1ddd5b5f-9dca-493f-8c32-a6092b0f7c6e"
      }
    },
    "updates": {
      "url": "https://u.expo.dev/1ddd5b5f-9dca-493f-8c32-a6092b0f7c6e"
    }
  }
}
